# Public api.devnet.solana.com blocks Cloudflare Worker IPs (403).
# Default (also in code): MagicBlock keyless devnet — works from Workers.
# Optional: Helius/QuickNode for higher limits, then pnpm secrets:put
SOLANA_RPC_URL=https://rpc.magicblock.app/devnet
SOLANA_CLUSTER=devnet
# Local/dev: path to Solana keypair JSON. Workers: set SERVER_KEYPAIR_JSON instead (no filesystem).
SERVER_KEYPAIR_PATH=.keys/server.json
# SERVER_KEYPAIR_JSON=[1,2,...]   # full secret key array as JSON (required on Cloudflare Workers)
STATION_SECRET=change-me
NEXT_PUBLIC_BASE_URL=http://localhost:3000
# Production: https://foodtrace.oliverchou.dev  (must also be set at OpenNext build time)

# Cloudflare D1 (server-only). Token: dash.cloudflare.com/profile/api-tokens
# Permission: Account → D1 → Edit. Account id: dashboard Workers overview.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_D1_DATABASE_ID=5c1ae019-3071-4e88-9f91-b3da7ce6b2b8

# Cloudflare R2 (S3-compatible). Create API token: R2 → Manage R2 API Tokens.
R2_ACCOUNT_ID=4d38bd1c6da9280b84dae11bb89d5400
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=hack-cmu-26
R2_ENDPOINT=https://4d38bd1c6da9280b84dae11bb89d5400.r2.cloudflarestorage.com
# Optional public base (r2.dev or custom domain). Leave blank to serve via /api/uploads.
R2_PUBLIC_URL=

# Photo validation (vision) still uses OpenRouter
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini

# Batch product reports via IFM (OpenAI-compatible)
IFM_API_KEY=
IFM_MODEL=IFM/K2-Horizon-375B-A23B
